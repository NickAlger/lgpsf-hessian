@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(MPI COMPONENTS C CXX)
find_dependency(PkgConfig)
pkg_check_modules(PETSC REQUIRED IMPORTED_TARGET PETSc)

# The fit component depends on lgpsf; tolerate its absence the same way the
# build does (glr-only installs simply do not export the fit targets).
find_package(lgpsf 0.1 QUIET CONFIG)

include("${CMAKE_CURRENT_LIST_DIR}/lgpsf_hessianTargets.cmake")

check_required_components(lgpsf_hessian)
